{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "MarketFlow",
    "Audience": "MarketFlow.Client",
    "Key": "replace-with-a-secure-development-key"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MarketFlowDb;Trusted_Connection=True;"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "OpenAi": {
    "ApiKey": "replace-with-openai-key",
    "Model": "gpt-4.1-mini"
  },
  "AllowedHosts": "*"
}
