# Copy this file to .env for local development. Keep real secrets in .env only.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

DB_CONNECTION_STRING=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketflow_db
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_ISSUER=MarketFlow
JWT_AUDIENCE=MarketFlowUsers
JWT_EXPIRES_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=7

ROOT_ADMIN_FULL_NAME=Root Admin
ROOT_ADMIN_EMAIL=admin@marketflow.com
ROOT_ADMIN_PASSWORD=

TENANT_SCHEMA_PREFIX=tenant_

REDIS_CONNECTION=localhost:6379

AI_PROVIDER=Fake

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

FRONTEND_URL=http://localhost:5173
